# ==============================================================================
# EDGE AI BASED EPILEPSY PATIENT MONITORING SYSTEM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Flask Server Settings
FLASK_ENV=development
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
SECRET_KEY=epilepsy-monitoring-edge-ai-secret-key-2026

# Frontend Origin for CORS
FRONTEND_URL=http://localhost:5173

# Firebase Cloud Firestore & Admin SDK
# Note: System operates 100% free with local SQLite fallback if left unconfigured!
FIREBASE_PROJECT_ID=your_firebase_project_id
GOOGLE_APPLICATION_CREDENTIALS=path_to_service_account_json
USE_LOCAL_FALLBACK_DB=true

# Twilio SMS Service Configuration
# Note: System operates in zero-cost in-app simulation mode if credentials are unset!
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_sender_number
TWILIO_STATUS_CALLBACK_URL=your_public_https_callback_url

# EEG Signal Processing & Biometrics (CHB-MIT Standards)
SAMPLING_RATE=256
WINDOW_DURATION_SEC=2.0
WINDOW_OVERLAP_RATIO=0.5
FILTER_LOWCUT=0.5
FILTER_HIGHCUT=45.0
NOTCH_FREQ=50.0

# Local EEG Dataset Path (CHB-MIT PhysioNet directory)
EEG_DATASET_PATH=backend/data/chbmit

# Risk Thresholds & Cooldown Rules
RISK_LOW_MAX=0.40
RISK_HIGH_MIN=0.70
ALERT_COOLDOWN_SECONDS=90
MAX_NOTIFICATION_RETRIES=3
